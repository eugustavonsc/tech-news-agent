OPENCODER_API_KEY=sk-...
OPENCODER_BASE_URL=https://opencode.ai/zen/go/v1
MODEL_ID=deepseek-v4-flash

# Modelo por tarefa (opcionais; vazio = usa MODEL_ID). Deixe os dois vazios:
# deepseek-v4-flash e glm-5.1 foram comparados e os DOIS passaram em tudo
# (formato e IRRELEVANTE exato), entao trocar seria gosto nao verificado.
#
# O curador roda ~144x/dia e responde por ~96% do consumo dos dois projetos:
# subi-lo de faixa custa ~US$ 24/mes contra US$ 2,30 e passa a competir com a
# cota que voce usa para revisar codigo. O summarizer roda ~7x/dia e e barato em
# qualquer modelo, mas nao ha defeito medido no Flash que justifique mexer.
#
# So modelos do endpoint /v1/chat/completions: este projeto nao tem a camada de
# despacho que o bot_instagram tem em llm.py.
CURATOR_MODEL_ID=
SUMMARIZER_MODEL_ID=

TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=-100123456789

DATABASE_URL=postgres://user:password@host:5432/dbname

NEWSAPI_ORG_KEY=
NEWSDATA_IO_KEY=
GNEWS_API_KEY=
